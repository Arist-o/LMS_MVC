@model Courses.Application.Course.DTOs.CreateCourseDto

@{
    ViewData["Title"] = "Створити курс";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form method="post" asp-action="Create">
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Назва</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Опис</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="InstructorId" class="form-label">Викладач</label>
            <select asp-for="InstructorId" asp-items="ViewBag.Instructors" class="form-select">
                <option value="">Оберіть викладача...</option>
            </select>
            <span asp-validation-for="InstructorId" class="text-danger"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsPublished" class="form-check-input" />
            <label asp-for="IsPublished" class="form-check-label">Опубліковано</label>
        </div>

        <button type="submit" class="btn btn-success">Зберегти</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>
