@model Courses.Application.Common.Models.PagedList<Courses.Application.Course.DTOs.CourseResponseDto>

@{
    ViewData["Title"] = "Курси";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form method="get" class="mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <input type="text" name="search" class="form-control" placeholder="Пошук..." value="@Context.Request.Query["search"]" />
            </div>
            <div class="col-auto">
                <select name="sortBy" class="form-select">
                    <option value="">Сортування за замовчуванням</option>
                    <option value="title_asc" selected="@(Context.Request.Query["sortBy"] == "title_asc")">Назва (А-Я)</option>
                    <option value="title_desc" selected="@(Context.Request.Query["sortBy"] == "title_desc")">Назва (Я-А)</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Застосувати</button>
            </div>
        </div>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">Створити курс</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Назва</th>
                    <th>Опис</th>
                    <th>Статус</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var course in Model.Items)
                    {
                        <tr>
                            <td>@course.Title</td>
                            <td>@course.Description</td>
                            <td>@(course.IsPublished ? "Опубліковано" : "Чернетка")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-info">Деталі</a>
                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-primary">Редагувати</a>
                                <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-sm btn-danger">Видалити</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">Курси не знайдено.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Пагінація">
            <ul class="pagination">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="?page=@(Model.Page - 1)&pageSize=@Model.PageSize&search=@Context.Request.Query["search"]&sortBy=@Context.Request.Query["sortBy"]">Попередня</a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.Page == i ? "active" : "")">
                        <a class="page-link" href="?page=@i&pageSize=@Model.PageSize&search=@Context.Request.Query["search"]&sortBy=@Context.Request.Query["sortBy"]">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="?page=@(Model.Page + 1)&pageSize=@Model.PageSize&search=@Context.Request.Query["search"]&sortBy=@Context.Request.Query["sortBy"]">Наступна</a>
                </li>
            </ul>
        </nav>
    }
</div>
