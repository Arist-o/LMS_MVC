@model Courses.Application.Review.DTOs.UpdateReviewDto

@{
    ViewData["Title"] = "Редагувати відгук";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form method="post" asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        
        <div class="mb-3">
            <label asp-for="Rating" class="form-label">Оцінка (1-5)</label>
            <input asp-for="Rating" type="number" class="form-control" min="1" max="5" />
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="Comment" class="form-label">Коментар</label>
            <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsApproved" class="form-check-input" />
            <label asp-for="IsApproved" class="form-check-label">Схвалено</label>
        </div>

        <button type="submit" class="btn btn-primary">Зберегти</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>
