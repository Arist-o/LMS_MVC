@model Courses.Application.Lesson.DTOs.LessonResponseDto

@{
    ViewData["Title"] = "Lesson Details";
}

<h1>Lesson Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        
        <dt class="col-sm-2">Course Title</dt>
        <dd class="col-sm-10">@Model.CourseTitle</dd>
        
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        
        <dt class="col-sm-2">Video URL</dt>
        <dd class="col-sm-10">@Model.VideoUrl</dd>
        
        <dt class="col-sm-2">Order Index</dt>
        <dd class="col-sm-10">@Model.OrderIndex</dd>

        <dt class="col-sm-2">Created At</dt>
        <dd class="col-sm-10">@Model.CreatedAt.ToString("g")</dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
    {
        <ul class="nav nav-tabs mb-3" id="lessonTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="info" aria-selected="true">Інформація</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tests-tab" data-bs-toggle="tab" data-bs-target="#tests" type="button" role="tab" aria-controls="tests" aria-selected="false">Тести</button>
            </li>
        </ul>
        <div class="tab-content" id="lessonTabsContent">
            <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
                <a asp-controller="Tests" asp-action="Create" asp-route-lessonId="@Model.Id" class="btn btn-success">Додати тест</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            </div>
            <div class="tab-pane fade" id="tests" role="tabpanel" aria-labelledby="tests-tab">
                <div class="alert alert-info">Щоб переглянути або створити тести, перейдіть до <a asp-controller="Tests" asp-action="Index">розділу Тестів</a>.</div>
                <a asp-controller="Tests" asp-action="Create" asp-route-lessonId="@Model.Id" class="btn btn-success">Створити перший тест</a>
            </div>
        </div>
    }
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
