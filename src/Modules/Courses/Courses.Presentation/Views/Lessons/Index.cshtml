@model Courses.Application.Common.Models.PagedList<Courses.Application.Lesson.DTOs.LessonResponseDto>

@{
    ViewData["Title"] = "Lessons";
}

<h1>Lessons</h1>

@if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
{
<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
}
<table class="table table-striped">
    <thead>
        <tr>
            <th>Course ID</th>
            <th>Title</th>
            <th>Video URL</th>
            <th>Order Index</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.CourseId</td>
                <td>@item.Title</td>
                <td>@item.VideoUrl</td>
                <td>@item.OrderIndex</td>
                <td>@item.CreatedAt.ToString("g")</td>
                <td>
                    @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> <text>|</text>
                    }
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
                    {
                        <text>|</text> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <ul class="pagination">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)">Previous</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">Previous</span></li>
        }
        
        <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
        
        @if (Model.HasNextPage)
        {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">Next</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">Next</span></li>
        }
    </ul>
</div>
