@model Courses.Application.Test.DTOs.TestResponseDto

@{
    ViewData["Title"] = "Test Details";
}

<h1>Test Details</h1>

<div>
    <ul class="nav nav-tabs mb-3" id="testTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="info" aria-selected="true">Інформація</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="questions-tab" data-bs-toggle="tab" data-bs-target="#questions" type="button" role="tab" aria-controls="questions" aria-selected="false">Питання</button>
        </li>
    </ul>

    <div class="tab-content" id="testTabsContent">
        <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
            <dl class="row">
                <dt class="col-sm-2">ID</dt>
                <dd class="col-sm-10">@Model.Id</dd>

                <dt class="col-sm-2">Lesson ID</dt>
                <dd class="col-sm-10">@Model.LessonId</dd>

                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@Model.Title</dd>

                <dt class="col-sm-2">Max Score</dt>
                <dd class="col-sm-10">@Model.MaxScore</dd>
                
                <dt class="col-sm-2">Created At</dt>
                <dd class="col-sm-10">@Model.CreatedAt</dd>
                
                <dt class="col-sm-2">Updated At</dt>
                <dd class="col-sm-10">@Model.UpdatedAt</dd>
            </dl>
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit Test</a>
            </div>
        </div>

        <div class="tab-pane fade" id="questions" role="tabpanel" aria-labelledby="questions-tab">
            @if (Model.Questions != null && Model.Questions.Any())
            {
                <ul class="list-group mb-3">
                    @foreach (var question in Model.Questions)
                    {
                        <li class="list-group-item">
                            <strong>@question.Text</strong> (@question.Points points)
                            <ul>
                                @foreach (var option in question.Options)
                                {
                                    <li style="@(option.IsCorrect ? "font-weight: bold; color: green;" : "")">
                                        @option.Text @(option.IsCorrect ? "✓" : "")
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>No questions added yet.</p>
            }
            <div class="mt-3">
                <a asp-controller="Questions" asp-action="Create" asp-route-testId="@Model.Id" class="btn btn-primary">Add Question</a>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
