@model Courses.Application.Test.DTOs.TestResponseDto

@{
    ViewData["Title"] = "Delete Test";
}

<h1>Delete Test</h1>

<h3>Are you sure you want to delete this test?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Max Score</dt>
        <dd class="col-sm-10">@Model.MaxScore</dd>
    </dl>
    
    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
