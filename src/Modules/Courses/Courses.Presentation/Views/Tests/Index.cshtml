@model Courses.Application.Common.Models.PagedList<Courses.Application.Test.DTOs.TestResponseDto>

@{
    ViewData["Title"] = "Tests";
}

<h1>Tests</h1>

@if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
{
<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>Max Score</th>
            <th>Lesson ID</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Items) {
        <tr>
            <td>@item.Title</td>
            <td>@item.MaxScore</td>
            <td>@item.LessonId</td>
            <td>
                @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> <text>|</text>
                }
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
                {
                    <text>|</text> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>

<div>
    <span>Page @Model.Page of @Math.Ceiling((double)Model.TotalCount / Model.PageSize)</span>
</div>
